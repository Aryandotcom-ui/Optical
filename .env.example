# ─────────────────────────────────────────────────────────────────────────────
# Environment for local development.
# `pnpm run setup` copies this file to `.env` (it never overwrites an existing one).
# Both apps read the root `.env`. Every variable is validated at startup; a
# missing or malformed value stops the app with a message naming the variable.
#
# Format: each variable has a comment with
#   purpose · default · required/optional · which app reads it
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ──────────────────────────────────────────────────────────────────

# Runtime mode: development | test | production. · default: development · optional · web, api
NODE_ENV=development

# Feature flag overrides, comma-separated name=on|off (e.g. googleOAuth=on,analytics=off).
# Known flags and defaults: packages/config/src/flags.ts. Unknown names fail startup.
# · default: none · optional · web, api
FEATURE_FLAGS=

# ── Local services (docker-compose.yml) ────────────────────────────────────
# Host ports for the Docker services. If you change one, update the matching URL below.

# Postgres host port. · default: 5432 · optional · docker compose
POSTGRES_PORT=5432
# Redis host port. · default: 6379 · optional · docker compose
REDIS_PORT=6379
# Mailpit SMTP port (emails sent by the API land here). · default: 1025 · optional · docker compose
MAILPIT_SMTP_PORT=1025
# Mailpit web inbox, open http://localhost:8025. · default: 8025 · optional · docker compose
MAILPIT_UI_PORT=8025

# ── API (apps/api) ──────────────────────────────────────────────────────────

# Postgres connection string. · no default · REQUIRED · api
DATABASE_URL=postgresql://optical:optical@localhost:5432/optical
# Redis connection string (rate limits, caches, job queues). Use rediss:// for TLS. · no default · REQUIRED · api
REDIS_URL=redis://localhost:6379
# Interface the API listens on. · default: 0.0.0.0 · optional · api
API_HOST=0.0.0.0
# Port the API listens on. · default: 4000 · optional · api
API_PORT=4000
# Public base URL of the API, used in the OpenAPI document and links in emails. · default: http://localhost:4000 · optional · api
API_PUBLIC_URL=http://localhost:4000
# Browser origins allowed to call the API with cookies, comma-separated. · default: http://localhost:3000 · optional · api
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Log level: fatal | error | warn | info | debug | trace | silent. · default: info · optional · api
LOG_LEVEL=info
# Human-readable logs instead of JSON. · default: on in development, off otherwise · optional · api
LOG_PRETTY=
# Trust X-Forwarded-* headers. Turn on only behind a reverse proxy you control. · default: false · optional · api
TRUST_PROXY=false
# Serve interactive API docs at /docs. · default: true · optional · api
API_DOCS_ENABLED=true

# ── Web (apps/web) ──────────────────────────────────────────────────────────

# Canonical public URL of the storefront (metadata, sitemaps, emails). · default: http://localhost:3000 · optional · web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API base URL as seen from the browser. Inlined at build time. · default: http://localhost:4000 · optional · web
NEXT_PUBLIC_API_URL=http://localhost:4000
# API base URL for server-side calls (e.g. http://api:4000 inside Docker). · default: NEXT_PUBLIC_API_URL · optional · web
API_INTERNAL_URL=
