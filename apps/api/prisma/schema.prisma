// Data model. Money is always Int minor units (paise). Catalogue vocabularies
// (shape, material, colour family …) are text columns validated by the shared
// Zod enums and by CHECK constraints in the migrations; workflow states are
// Prisma enums. Search vectors are maintained by a trigger (see migrations).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased.
  email            String    @unique
  passwordHash     String?
  name             String
  phone            String?
  role             Role      @default(CUSTOMER)
  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  marketingOptIn   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  refreshTokens RefreshToken[]
  addresses     Address[]
  carts         Cart[]
  wishlist      Wishlist?
  prescriptions Prescription[]     @relation("PrescriptionOwner")
  verified      Prescription[]     @relation("PrescriptionVerifier")
  orders        Order[]
  reviews       Review[]
  redemptions   CouponRedemption[]
  auditLogs     AuditLog[]

  @@index([role])
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash    String    @unique
  /// All tokens from one sign-in share a family; reuse of a rotated token revokes the family.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Address {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String    @default("IN")
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String @id @default(uuid(7)) @db.Uuid
  /// One of the shared `categorySlugs`.
  slug        String @unique
  name        String
  description String
  sortOrder   Int    @default(0)

  products Product[]
}

model Collection {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  tagline     String
  description String
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String @db.Uuid
  productId    String @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id               String                   @id @default(uuid(7)) @db.Uuid
  slug             String                   @unique
  name             String
  /// 'frame' | 'accessory'
  type             String
  categoryId       String                   @db.Uuid
  description      String
  materialsAndCare String
  basePriceMinor   Int
  /// 'women' | 'men' | 'unisex' | 'kids', null for accessories.
  fit              String?
  styleTags        String[]
  lensesAvailable  Boolean                  @default(true)
  isPublished      Boolean                  @default(false)
  launchedAt       DateTime                 @default(now())
  seoTitle         String?
  seoDescription   String?
  /// Denormalised from published reviews.
  ratingAverage    Float?
  ratingCount      Int                      @default(0)
  /// Editorial + sales signal for the "Recommended" sort.
  popularity       Int                      @default(0)
  /// Extra words for search (colours, shape, material); maintained by the app.
  searchText       String                   @default("")
  /// Maintained by the product_search_vector trigger.
  searchVector     Unsupported("tsvector")?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  category      Category            @relation(fields: [categoryId], references: [id])
  frame         FrameSpec?
  variants      ProductVariant[]
  images        ProductImage[]
  faceShapes    FaceShapeAffinity[]
  collections   CollectionProduct[]
  reviews       Review[]
  questions     ProductQuestion[]
  wishlistItems WishlistItem[]

  @@index([categoryId, isPublished])
  @@index([basePriceMinor])
  @@index([ratingAverage])
  @@index([launchedAt])
  @@index([popularity])
  @@index([fit])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([searchVector], type: Gin, map: "Product_searchVector_idx")
}

model FrameSpec {
  productId    String   @id @db.Uuid
  shape        String
  lensWidthMm  Float
  lensHeightMm Float
  bridgeMm     Float
  templeMm     Float
  totalWidthMm Float
  weightG      Float
  material     String
  rimType      String
  hinge        String
  features     String[]
  nosePads     Boolean  @default(false)
  /// Optional hand-made model replacing the procedural geometry.
  glbUrl       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shape])
  @@index([material])
  @@index([rimType])
  @@index([totalWidthMm])
}

model FaceShapeAffinity {
  productId String @db.Uuid
  faceShape String
  /// 0–1, how well the frame suits the face shape.
  score     Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, faceShape])
  @@index([faceShape])
}

model ProductVariant {
  id                 String   @id @default(uuid(7)) @db.Uuid
  productId          String   @db.Uuid
  sku                String   @unique
  colourName         String
  colourFamily       String
  swatchHex          String
  /// Second colour: tortoise spots or the far end of a gradient.
  secondaryHex       String?
  /// Metal hardware colour (hinges, wire parts) on acetate and mixed frames.
  hardwareHex        String?
  finish             String
  /// Null uses the product's base price.
  priceOverrideMinor Int?
  /// Default lens tint for sunglasses; null for clear lenses.
  lensTintHex        String?
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  stock        StockItem?
  reservations StockReservation[]
  adjustments  StockAdjustment[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([colourFamily])
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  variantId String? @db.Uuid
  url       String
  alt       String
  width     Int
  height    Int
  /// 'front' | 'angle' | 'side' | 'on-face' | 'detail'
  kind      String
  position  Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model StockItem {
  variantId         String   @id @db.Uuid
  onHand            Int      @default(0)
  /// Units held by active reservations; available = onHand − reserved.
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model StockReservation {
  id          String    @id @default(uuid(7)) @db.Uuid
  variantId   String    @db.Uuid
  orderId     String?   @db.Uuid
  quantity    Int
  expiresAt   DateTime
  /// Set when the hold ends without a sale (expired or cancelled).
  releasedAt  DateTime?
  /// Set when the hold turns into a sale and the units leave stock.
  committedAt DateTime?
  createdAt   DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([orderId])
  @@index([expiresAt, releasedAt])
}

model StockAdjustment {
  id        String   @id @default(uuid(7)) @db.Uuid
  variantId String   @db.Uuid
  delta     Int
  reason    String
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

// ─── Lens catalogue (shape defined in packages/shared/src/lens/catalog.ts) ────

model LensPurpose {
  code                 String   @id
  name                 String
  description          String
  basePriceMinor       Int
  requiresPrescription Boolean
  requiresAdd          Boolean
  includedCoatingCodes String[]
  defaultIndexCode     String
  defaultTintCode      String
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model LensIndexOption {
  code            String   @id
  refractiveIndex Float
  name            String
  description     String
  priceMinor      Int
  maxPower        Float
  recommendedUpTo Float
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model LensCoating {
  code       String   @id
  name       String
  benefit    String
  priceMinor Int
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model LensPackage {
  code         String   @id
  name         String
  description  String
  coatingCodes String[]
  priceMinor   Int
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model LensTint {
  code              String   @id
  kind              String
  name              String
  description       String
  priceMinor        Int
  /// [{ code, name, hex }]
  colours           Json
  supportsIntensity Boolean
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model LensRule {
  id        String   @id
  /// RuleCondition[]
  when      Json
  /// OptionRef
  forbid    Json
  reason    String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ─── Cart and wishlist ───────────────────────────────────────────────────────

model Cart {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String?   @db.Uuid
  /// SHA-256 of the guest cookie token.
  guestTokenHash String?   @unique
  couponCode     String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  cartId         String   @db.Uuid
  variantId      String   @db.Uuid
  quantity       Int
  /// Immutable LensConfig snapshot, or null for frame only / accessories.
  lensConfig     Json?
  /// Lens quote lines at the time of adding.
  priceSnapshot  Json
  unitPriceMinor Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([variantId])
}

model Wishlist {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @unique @db.Uuid
  guestTokenHash String?  @unique
  /// Random token for the read-only share link.
  shareToken     String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  variantId  String?  @db.Uuid
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
}

// ─── Prescriptions ───────────────────────────────────────────────────────────

enum PrescriptionStatus {
  PENDING_REVIEW
  VERIFIED
  NEEDS_CORRECTION
}

model Prescription {
  id             String             @id @default(uuid(7)) @db.Uuid
  userId         String?            @db.Uuid
  label          String
  /// Versions form a chain: each edit creates a new row pointing at its predecessor.
  version        Int                @default(1)
  previousId     String?            @unique @db.Uuid
  /// SHA-256 of the guest session that uploaded it; only that session may attach it to a cart or order.
  ownerTokenHash String?
  /// Validated Prescription values, or null when only a file was uploaded.
  values         Json?
  /// Private storage key of the uploaded photo or PDF.
  fileKey        String?
  fileMime       String?
  prescribedAt   DateTime?
  expiresAt      DateTime?
  status         PrescriptionStatus @default(PENDING_REVIEW)
  verifiedById   String?            @db.Uuid
  verifiedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?

  user       User?         @relation("PrescriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?         @relation("PrescriptionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  previous   Prescription? @relation("PrescriptionVersions", fields: [previousId], references: [id])
  next       Prescription? @relation("PrescriptionVersions")
  orderItems OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([ownerTokenHash])
}

// ─── Orders and payments ─────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PRESCRIPTION_REVIEW
  IN_PRODUCTION
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
  STRIPE
  COD
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Order {
  id                    String          @id @default(uuid(7)) @db.Uuid
  /// Human-friendly, e.g. LO-26-000123.
  number                String          @unique
  userId                String?         @db.Uuid
  email                 String
  phone                 String?
  status                OrderStatus     @default(PENDING_PAYMENT)
  currency              String
  subtotalMinor         Int
  discountMinor         Int
  shippingMinor         Int
  codFeeMinor           Int
  taxMinor              Int
  totalMinor            Int
  couponCode            String?
  /// Address snapshot at the time of ordering.
  shippingAddress       Json
  shippingSpeed         String
  paymentProvider       PaymentProvider
  estimatedDeliveryFrom DateTime?       @db.Date
  estimatedDeliveryTo   DateTime?       @db.Date
  /// True while a prescription item still needs a verified prescription.
  awaitingPrescription  Boolean         @default(false)
  customerNote          String?
  internalNote          String?
  idempotencyKey        String?         @unique
  /// SHA-256 of the request body that used the idempotency key, to reject a reused key.
  idempotencyHash       String?
  /// The cart the order came from; emptied once the order is paid or confirmed.
  cartId                String?         @db.Uuid
  /// SHA-256 of the token in the guest tracking link.
  trackingTokenHash     String?
  trackingNumber        String?
  carrier               String?
  placedAt              DateTime        @default(now())
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  payments     Payment[]
  refunds      Refund[]
  reservations StockReservation[]
  redemption   CouponRedemption?

  @@index([userId, placedAt])
  @@index([status])
  @@index([email])
  @@index([awaitingPrescription])
}

model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @db.Uuid
  productId      String   @db.Uuid
  variantId      String   @db.Uuid
  prescriptionId String?  @db.Uuid
  // Snapshots: later catalogue edits never change a placed order.
  sku            String
  productName    String
  colourName     String
  imageUrl       String?
  quantity       Int
  unitPriceMinor Int
  lensConfig     Json?
  /// PriceLine[] for this item, including discount and tax shares.
  priceLines     Json
  totalMinor     Int
  createdAt      DateTime @default(now())

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  review       Review?

  @@index([orderId])
  @@index([variantId])
  @@index([prescriptionId])
}

model OrderEvent {
  id                String       @id @default(uuid(7)) @db.Uuid
  orderId           String       @db.Uuid
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  note              String?
  actorId           String?      @db.Uuid
  visibleToCustomer Boolean      @default(true)
  createdAt         DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id            String          @id @default(uuid(7)) @db.Uuid
  orderId       String          @db.Uuid
  provider      PaymentProvider
  providerRef   String?
  status        PaymentStatus   @default(CREATED)
  amountMinor   Int
  currency      String
  method        String?
  /// Hosted payment page for this attempt, so a retried request can return it again.
  actionUrl     String?
  failureReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
}

model Refund {
  id          String       @id @default(uuid(7)) @db.Uuid
  paymentId   String       @db.Uuid
  orderId     String       @db.Uuid
  amountMinor Int
  reason      String
  status      RefundStatus @default(PENDING)
  providerRef String?
  actorId     String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
}

// ─── Promotions ──────────────────────────────────────────────────────────────

model Coupon {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Upper-case.
  code               String    @unique
  description        String
  /// 'percentage' | 'fixed' | 'free-shipping'
  kind               String
  percentBasisPoints Int?
  amountMinor        Int?
  maxDiscountMinor   Int?
  minSubtotalMinor   Int       @default(0)
  firstOrderOnly     Boolean   @default(false)
  active             Boolean   @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  usageLimit         Int?
  usageCount         Int       @default(0)
  perCustomerLimit   Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id            String   @id @default(uuid(7)) @db.Uuid
  couponId      String   @db.Uuid
  orderId       String   @unique @db.Uuid
  userId        String?  @db.Uuid
  email         String
  discountMinor Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([email])
}

// ─── Reviews and Q&A ─────────────────────────────────────────────────────────

enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id           String           @id @default(uuid(7)) @db.Uuid
  productId    String           @db.Uuid
  userId       String?          @db.Uuid
  /// Set when the review comes from a delivered order: the verified-purchase badge.
  orderItemId  String?          @unique @db.Uuid
  authorName   String
  rating       Int
  title        String
  body         String
  status       ModerationStatus @default(PENDING)
  helpfulCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  votes     ReviewVote[]

  @@index([productId, status, createdAt])
  @@index([status])
}

model ReviewVote {
  reviewId  String   @db.Uuid
  /// User id, or a hash of the guest session, so each person votes once.
  voterKey  String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, voterKey])
}

model ProductQuestion {
  id           String           @id @default(uuid(7)) @db.Uuid
  productId    String           @db.Uuid
  authorName   String
  question     String
  answer       String?
  answeredById String?          @db.Uuid
  answeredAt   DateTime?
  status       ModerationStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

// ─── Content, messages and operations ────────────────────────────────────────

model HelpArticle {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  title       String
  /// 'ordering' | 'prescriptions' | 'lenses' | 'delivery' | 'returns' | 'care'
  topic       String
  body        String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topic, sortOrder])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "HelpArticle_title_trgm_idx")
}

model ContactMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  email       String
  orderNumber String?
  topic       String
  message     String
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actorEmail String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String       @id @default(uuid(7)) @db.Uuid
  to        String
  template  String
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sendAfter DateTime     @default(now())
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([status, sendAfter])
}

model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean
  description String
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
