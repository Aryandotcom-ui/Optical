# Runtime configuration for infra/deploy/docker-compose.prod.yml.
# Copy to production.env (git-ignored) and fill in. Every app reads this file;
# NEXT_PUBLIC_* values are also needed at image build time (DEPLOYMENT.md).

NODE_ENV=production

# Data stores (the compose services, or managed ones)
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql://optical:change-me-to-a-long-random-password@postgres:5432/optical
REDIS_URL=redis://redis:6379

# Public addresses
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# How the web server and worker reach the API inside the network
API_INTERNAL_URL=http://api:4000

# Secrets: generate with `openssl rand -base64 48`
APP_SECRET=

# Behind a TLS-terminating proxy or load balancer
TRUST_PROXY=false
# Cookies are Secure in production; browsers accept them on http://localhost too.
# COOKIE_DOMAIN=.shop.example.com

# Email (smtp://user:pass@host:587); smtp://mailpit:1025 with the local-mail profile
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=Lumen Optics <orders@shop.example.com>

# Uploads live on the `uploads` volume
UPLOAD_DIR=/data/uploads

# Payments: set one provider's keys (all keys of a provider together).
# Without one, only cash on delivery is offered. The mock provider is refused in production.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info
API_DOCS_ENABLED=false
