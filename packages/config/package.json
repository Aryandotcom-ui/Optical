{
  "name": "@optical/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./commerce": "./src/commerce.ts",
    "./address": "./src/address.ts",
    "./flags": "./src/flags.ts",
    "./env": "./src/env.ts",
    "./tokens": "./src/tokens.ts",
    "./eslint/base": "./eslint/base.js",
    "./eslint/next": "./eslint/next.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tailwind/preset.css": {
      "style": "./tailwind/preset.css",
      "default": "./tailwind/preset.css"
    }
